{
    "name": "cuigengji",
    "version": "1.0.0",
    "description": "催更姬 - AI 小说创作助手",
    "type": "module",
    "main": "electron/index.js",
    "author": "mistnest",
    "license": "SEE LICENSE IN LICENSE",
    "homepage": "https://github.com/mistnest/cuigengji",
    "repository": {
        "type": "git",
        "url": "https://github.com/mistnest/cuigengji.git"
    },
    "scripts": {
        "build:ts": "node dev/scripts/build-typescript.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build:preload": "node dev/scripts/build-preload.cjs",
        "prebuild:preload": "npm run build:ts",
        "ts:check-generated": "node dev/scripts/build-typescript.mjs --check",
        "preload:check": "node dev/scripts/build-preload.cjs --check",
        "prestart:electron": "npm run build:ts && npm run build:preload",
        "pretest": "npm run build:ts && npm run build:preload",
        "prebuild": "npm run build:ts && npm run build:preload",
        "prebuild:win": "npm run build:ts && npm run build:preload",
        "prepackage:win": "npm run build:ts && npm run build:preload",
        "start": "npm run start:electron",
        "start:electron": "node dev/scripts/start-electron.js",
        "dev": "npm run start:electron",
        "build": "electron-builder",
        "build:win": "electron-builder --win --x64",
        "package:win": "electron-builder --win --x64 --dir",
        "package:win:test": "npm run lint && npm run architecture:check && npm test -- --reporter=list && npm run package:win",
        "lint": "eslint \"src/**/*.js\" \"public/**/*.js\" \"electron/**/*.js\" \"electron/**/*.cjs\" \"shared/**/*.js\" \"dev/scripts/check-runtime-closure.js\" \"dev/scripts/build-preload.cjs\" \"dev/tests/**/*.js\" \"playwright.config.js\"",
        "test": "playwright test",
        "test:architecture": "playwright test dev/tests/architecture/",
        "test:api": "playwright test dev/tests/integration/",
        "test:interface": "playwright test dev/tests/interface/",
        "test:smoke": "playwright test --grep @smoke",
        "test:e2e": "playwright test dev/tests/electron/",
        "test:electron": "playwright test dev/tests/electron/",
        "test:real-dsh": "node dev/scripts/check-real-dsh-flow.mjs",
        "test:regression": "playwright test --grep @regression",
        "test:ui": "playwright test --ui",
        "test:report": "playwright show-report ../cuigengji-build/playwright-report",
        "test:install": "playwright install chromium",
        "architecture:check": "node dev/scripts/check-runtime-closure.js",
        "architecture:update": "node dev/scripts/check-runtime-closure.js --write",
        "fingerprint": "node dev/scripts/create-fingerprint-manifest.js"
    },
    "dependencies": {
        "@deepseek-ai/cordis-plugin-group": "1.0.1",
        "@deepseek-ai/dsh": "0.1.0-rc.7",
        "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.7",
        "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
        "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
        "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.7",
        "@deepseek-ai/dsh-tool-skill": "0.1.0-rc.7",
        "@deepseek-ai/dsh-tool-web": "0.1.0-rc.7",
        "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
        "crc": "^4.3.2",
        "express": "^4.21.0",
        "iconv-lite": "^0.4.24",
        "ipaddr.js": "1.9.1",
        "jschardet": "^3.1.4",
        "mammoth": "^1.12.0",
        "png-chunk-text": "^1.0.0",
        "png-chunks-extract": "^1.0.0",
        "sanitize-filename": "^1.6.3",
        "turndown": "7.2.4",
        "undici": "^7.27.2",
        "uuid": "^11.0.0",
        "write-file-atomic": "^5.0.1",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "electron": "43.2.0",
        "electron-builder": "26.15.3",
        "eslint": "^8.57.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=24"
    },
    "build": {
        "appId": "com.mistnest.cuigengji",
        "productName": "催更姬",
        "npmRebuild": false,
        "extraMetadata": {
            "cuigengjiSignature": "cgj-mistnest-2026-community-source",
            "cuigengjiSchemaOwner": "mistnest-cuigengji",
            "repository": "https://github.com/mistnest/cuigengji"
        },
        "directories": {
            "output": "../cuigengji-build/dist"
        },
        "asar": true,
        "asarUnpack": [
            "node_modules/**"
        ],
        "extraResources": [
            {
                "from": "node_modules/@deepseek-ai",
                "to": "app.asar.unpacked/node_modules/@deepseek-ai",
                "filter": [
                    "**/*",
                    "!**/*.map",
                    "!**/{test,tests,__tests__,example,examples}/**"
                ]
            }
        ],
        "files": [
            "src/**/*",
            "public/**/*",
            "electron/**/*",
            "shared/**/*",
            "package.json",
            "!node_modules/**/*.map",
            "!node_modules/**/{test,tests,__tests__,example,examples}/**"
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "compression": "maximum",
            "electronLanguages": [
                "zh-CN",
                "en-US"
            ],
            "icon": "public/avatar.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "shortcutName": "催更姬",
            "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.productivity"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Office"
        }
    }
}
